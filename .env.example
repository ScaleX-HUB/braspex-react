# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BRASPEX
# ==============================================================================
# Copie para .env. Não commite o .env.

# URL do projeto, sem barra no final. Ex.: https://xxxx.supabase.co
SUPABASE_URL=

# Chave anon/public (Settings → API)
SUPABASE_ANON_KEY=

# Chave service_role. Fica só no servidor. Não use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Schema exposto no PostgREST. No Supabase Cloud o padrão é public.
SUPABASE_SCHEMA=public
VITE_SUPABASE_SCHEMA=public

# O navegador usa este proxy. A URL real fica nas variáveis acima.
VITE_SUPABASE_PROXY_URL=/api/supabase-proxy

# URI do Postgres (Settings → Database → Connection string). Só para o setup.
# SUPABASE_DB_URL=

# Configurações de Storage / Catálogos
VITE_CATALOGS_BUCKET=catalogs
VITE_CATALOGS_MAX_PDF_MB=25
VITE_CATALOGS_MAX_COVER_MB=5

PORT=3000
