# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BRASPEX
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PARA O FRONTEND NA VERCEL (Build & Runtime do Cliente)
# ------------------------------------------------------------------------------
# URL do Supabase direto (usado em desenvolvimento local)
VITE_SUPABASE_URL=http://173.249.32.99:54321

# Chave anônima pública do Supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzYwMDE1NTc0LCJleHAiOjIwNzUzNzU1NzR9.zOkNw3Bh2qhDjrOYK8Gptx7Kv_ADs-9x0732M9pLYoQ

# Schema utilizado no PostgREST
VITE_SUPABASE_SCHEMA=braspex

# Rota do proxy para evitar Mixed Content (HTTPS -> HTTP).
# Na Vercel, o padrão é '/api/supabase-proxy' (atendido pela Serverless Function).
# Caso queira apontar para o backend Dokku/VPS existente, use: https://seu-backend.com/api/supabase-proxy
VITE_SUPABASE_PROXY_URL=/api/supabase-proxy

# Forçar uso do proxy mesmo em localhost (true/false)
VITE_SUPABASE_FORCE_PROXY=false

# Configurações de Storage / Catálogos
VITE_CATALOGS_BUCKET=catalogs
VITE_CATALOGS_MAX_PDF_MB=25
VITE_CATALOGS_MAX_COVER_MB=5


# ------------------------------------------------------------------------------
# 2. VARIÁVEIS PARA A SERVERLESS FUNCTION NA VERCEL (api/supabase-proxy.js)
#    Configure estas variáveis nas "Environment Variables" da Vercel
# ------------------------------------------------------------------------------
SUPABASE_URL=http://173.249.32.99:54321
SUPABASE_SCHEMA=braspex
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzYwMDE1NTc0LCJleHAiOjIwNzUzNzU1NzR9.zOkNw3Bh2qhDjrOYK8Gptx7Kv_ADs-9x0732M9pLYoQ

# Opcional (Recomendado): Service role key para operações administrativas
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 3. VARIÁVEIS PARA O SERVIDOR BACKEND (Dokku / Node.js server.js)
# ------------------------------------------------------------------------------
PORT=3000
